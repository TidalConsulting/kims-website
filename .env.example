# Public site URL (used for the sitemap, social previews, JSON-LD and PayMongo return links)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Where orders and messages go (set at least one before going live) ---
# The live site refuses orders and messages until one of these works, so nothing is silently lost.
# Email via Resend (resend.com): the shop inbox, and a sender on a domain you've verified there.
RESEND_API_KEY=
SHOP_EMAIL=
EMAIL_FROM="Crumb & Kettle <orders@yourdomain.com>"
# And/or a webhook, e.g. a Zapier or Make hook that texts or Vibers the kitchen, or adds
# newsletter sign-ups to Mailchimp/Klaviyo. Receives JSON: { kind, subject, text, data }.
NOTIFY_WEBHOOK_URL=

# --- Online payment (optional) ---
# Without these, customers pay at pickup or on delivery.
# PayMongo (paymongo.com): use sk_test_… while testing, sk_live_… to go live.
PAYMONGO_SECRET_KEY=
# From a PayMongo webhook pointed at https://<your-site>/api/paymongo/webhook
# listening for "checkout_session.payment.paid".
PAYMONGO_WEBHOOK_SECRET=
